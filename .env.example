# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# API server port (defaults to 3457)
API_PORT=3457

# Public origin, used for cookies and magic-link URLs
SITE_URL=http://localhost:5173

# Resend - required to send magic-link sign-in emails
RESEND_API_KEY=

# Claude API - required for /api/marina-scrape (admin only)
CLAUDE_API_KEY=
