# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Postgres connection string for the same project (Project Settings ->
# Database -> Connection string -> URI). Only used by scripts/dump-schema.sh.
SUPABASE_DB_URL=

# Gemini API - required for /api/marina-scrape (admin only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email sign-in (Resend)
RESEND_API_KEY=
# Required; no default. Format: "Display Name <address@yourdomain>".
EMAIL_FROM=

# Server (required; no default)
# For local development use http://localhost:5173 (the Vite dev server).
SITE_URL=
NODE_ENV=production
# API_PORT (optional): the port server/index.ts listens on. Defaults to
# 3457 if unset, which is what vite.config.ts's dev proxy and
# deploy/nginx.conf's proxy_pass both assume; only set it if you also
# update both of those.
API_PORT=

# scripts/create-admin.ts only
ADMIN_EMAIL=

# deploy/golive.sh only
DOMAIN=
CERTBOT_EMAIL=
APP_DIR=
