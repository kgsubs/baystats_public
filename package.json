{
  "name": "baystats",
  "version": "1.0.0",
  "description": "BayStats - Maritime Information Dashboard",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node --import tsx/esm server/index.ts\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "seed": "npx ts-node scripts/seed-vessel-data.ts"
  },
  "keywords": [
    "rodney-bay",
    "maritime",
    "dashboard"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@netlify/functions": "^5.1.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@supabase/supabase-js": "^2.95.3",
    "@types/express": "^5.0.6",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "resend": "^6.9.2",
    "tsx": "^4.21.0"
  }
}
